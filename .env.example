# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- App ---
# OpenAI API key used by /api/receipts/extract for receipt extraction.
OPENAI_API_KEY=sk-...

# --- Deployment (docker-compose + nginx + certbot) ---
# Public domain whose A/AAAA record points at this server. Used by nginx for
# server_name and for the TLS certificate.
DOMAIN=moses.example.com

# Email Let's Encrypt uses for expiry notices (deploy/init-letsencrypt.sh).
CERTBOT_EMAIL=you@example.com
