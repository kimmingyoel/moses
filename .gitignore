# Dependencies
/node_modules

# Next.js build output (output: "standalone" → only .next is produced)
/.next

# Local font assets (licensed — kept out of the repo)
/public/fonts/*
!/public/fonts/.gitkeep

# Design source files
/design_assets/

# Claude Code local files
.claude/

# Environment variables & secrets
.env*
!.env.example

# Credentials / certificates (guard against committing keys)
*.pem

# npm debug log
npm-debug.log*

# OS files
.DS_Store

# TypeScript
*.tsbuildinfo
next-env.d.ts
